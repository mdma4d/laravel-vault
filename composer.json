{
    "name": "mdma4d/laravel-vault",
    "description": "Laravel HashiCorp Vault integration (secrets, database dynamic creds, encryption, hashing)",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmytro Rudiy",
            "email": "mdma4d@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mdma4d\\Vault\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mdma4d\\Vault\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mdma4d\\Vault\\VaultServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
